{
  "name": "behavproof-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-artifacts.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
